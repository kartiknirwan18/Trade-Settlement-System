# ---------------------------------------------------------------------------
# Trade Settlement & Invoice Reconciliation System - environment template
# Copy this file to `.env` (or export the variables in your shell) and fill in
# real values. NEVER commit the resulting .env file.
# ---------------------------------------------------------------------------

# Active Spring profile: `mysql` for a real MySQL database, `dev` for the
# in-memory H2 database used for local smoke testing.
SPRING_PROFILES_ACTIVE=mysql

# --- MySQL (used by the `mysql` profile) -----------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trade_settlement
DB_USERNAME=settlement
DB_PASSWORD=change-me

# --- HTTP ------------------------------------------------------------------
SERVER_PORT=8080

# --- JWT -------------------------------------------------------------------
# Must be at least 32 characters (256 bits) for HS256. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-value-min-32-chars
JWT_EXPIRATION_MINUTES=120

# --- Business configuration ------------------------------------------------
SETTLEMENT_DEFAULT_TAX_PERCENTAGE=5.00
SETTLEMENT_PAYMENT_TERM_DAYS=30
SETTLEMENT_ALLOW_OVERPAYMENT=false
SETTLEMENT_RECONCILIATION_TOLERANCE=0.01
SETTLEMENT_OVERDUE_CRON="0 0 * * * *"
SETTLEMENT_SEED_SAMPLE_DATA=true
